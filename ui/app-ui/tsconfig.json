{
  // The app's pages (main window, editor window, render page); `npm run typecheck:ui` checks them strictly.
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "useDefineForClassFields": false,
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "types": ["vite/client"],
    "paths": { "@resources/*": ["../../resources/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
