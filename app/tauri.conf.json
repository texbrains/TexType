{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TexType",
  "identifier": "com.textype.app",
  "version": "0.0.0",
  "build": {
    "frontendDist": "../ui/app-ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
